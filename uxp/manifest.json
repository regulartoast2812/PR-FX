{
  "id": "com.prfx.edie",
  "name": "Edie for Premiere",
  "version": "0.2.0",
  "manifestVersion": 5,
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "edie",
      "label": { "default": "Edie (Demo)" },
      "minimumSize": { "width": 280, "height": 220 },
      "maximumSize": { "width": 1000, "height": 2000 },
      "preferredDockedSize": { "width": 380, "height": 520 },
      "preferredFloatingSize": { "width": 420, "height": 560 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "http://127.0.0.1:27389",
        "http://localhost:27389"
      ]
    },
    "allowCodeGenerationFromStrings": false
  }
}
