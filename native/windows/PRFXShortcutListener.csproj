<Project Sdk="Microsoft.NET.Sdk">
  <!--
    .NET Framework 4.8 ships with every supported Windows 10/11 install, so the
    exe is ~100 KB and creatives install nothing. Builds on Windows or macOS:
      Windows: build-windows.cmd
      macOS:   build-windows.sh   (cross-compiles; cannot run it)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>PRFXShortcutListener</AssemblyName>
    <RootNamespace>PrFxShortcutListener</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PrfxBuild Condition="'$(PrfxBuild)' == ''">source-dev</PrfxBuild>
    <InformationalVersion>$(PrfxBuild)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>PR FX Shortcut Listener</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
